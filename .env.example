# Copy to .env for Docker Compose. Do not commit real credentials.
PUBLIC_ORIGIN=http://127.0.0.1:8002
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
LAMMA_ENV=development
MAIL_MODE=local
REQUIRE_VERIFICATION=1
